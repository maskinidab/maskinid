# MaskinID – all configuration in one place (step 26, docs/runbooks/setup.md). Copy to .env for local development
# (never commit .env). Values here are safe defaults. Secrets for Edge Functions are set with `supabase secrets set`,
# secrets for the Vercel function in the Vercel project, and GitHub Actions secrets per environment.

# ---------------------------------------------------------------------------------------------------------------
# Web app (Vite, public – never put a secret in a VITE_ variable)
# ---------------------------------------------------------------------------------------------------------------
# "local" runs the real database in the browser (PGlite) with demo data – no backend needed. "supabase" uses a project.
VITE_DATA_SOURCE=local
VITE_DEMO_MODE=true
# MaskinID Supabase project "maskinid" (organisation maskinidab, region eu-north-1). The publishable key is meant for
# the frontend – all access is controlled by RLS and function grants.
VITE_SUPABASE_URL=https://ogpqatvgamzgwwhgtlcr.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_-QCInqZeE343lw9Kagjd5A_MGpoz8-5
VITE_SENTRY_DSN=
VITE_TURNSTILE_SITE_KEY=
VITE_VAPID_PUBLIC_KEY=
# "hash" for static demo hosting without rewrites.
VITE_ROUTER=

# ---------------------------------------------------------------------------------------------------------------
# Local database for tests (npm run test:db / db:reset)
# ---------------------------------------------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# ---------------------------------------------------------------------------------------------------------------
# Edge Functions (supabase secrets set …). SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# by Supabase automatically.
# ---------------------------------------------------------------------------------------------------------------
DEMO_MODE=true
APP_ORIGIN=https://maskinid.se
PUBLIC_APP_URL=https://maskinid.se
# Scheduled jobs (pg_net) send this in x-cron-secret; the same value is stored in Vault as "cron_secret".
CRON_SECRET=
# Salt for hashing IP addresses in rate limits (also in app.secrets / Vault as ip_hash_salt).
IP_HASH_SALT=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Identity and signatures (BankID through an OIDC broker, e.g. Criipto/Signicat). mock outside production only.
IDENTITY_PROVIDER=bankid
SIGNATURE_PROVIDER=bankid
BANKID_OIDC_DOMAIN=
BANKID_OIDC_CLIENT_ID=
BANKID_OIDC_CLIENT_SECRET=
BANKID_STATE_SECRET=

# Company lookup (Roaring / Bolagsverket data)
COMPANY_LOOKUP_PROVIDER=roaring
ROARING_CLIENT_ID=
ROARING_CLIENT_SECRET=

# Nameplate and listing OCR (Anthropic)
OCR_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# E-mail (Resend)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=MaskinID <noreply@maskinid.se>

# Virus scanning of uploads (ClamAV REST)
CLAMAV_URL=
CLAMAV_TOKEN=

# Daily event anchor published as a commit in a public repository (anchor-events)
ANCHOR_GITHUB_REPO=
ANCHOR_GITHUB_TOKEN=

# Payments (step 23, ADR 0020). Only sk_test_ keys unless STRIPE_ALLOW_LIVE=true. One price per paid plan and a 25 %
# exclusive tax rate so VAT is shown separately.
PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_RATE_ID=
STRIPE_PRICE_DEALER=
STRIPE_PRICE_FINANCIER=
STRIPE_PRICE_INSURER=
STRIPE_PRICE_MARKETPLACE=
STRIPE_ALLOW_LIVE=false

# Web push (step 24, ADR 0021): a P-256 VAPID key pair; the public key is also VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:drift@maskinid.se

# Integrations (step 25, ADR 0022, docs/runbooks/integrations.md). Telematics credentials are entered per connection
# in the app and stored encrypted.
VEHICLE_REGISTRY_PROVIDER=transportstyrelsen
VTR_API_URL=
VTR_API_TOKEN=
THEFT_REGISTRY_PROVIDER=larmtjanst
LARMTJANST_API_URL=
LARMTJANST_API_KEY=

# ---------------------------------------------------------------------------------------------------------------
# Vercel function api/pdf.ts (server-side PDFs). Uses the anon key + the caller's token; never the service key.
# ---------------------------------------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------------------------------------------
# Market ingest (apps/ingest, GitHub Actions ingest.yml)
# ---------------------------------------------------------------------------------------------------------------
SUPABASE_SECRET_KEY=

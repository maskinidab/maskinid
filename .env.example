# Copy to .env (never commit .env). Values here are safe defaults for local development.

# --- Client (Vite) ---------------------------------------------------------
# Data source: "local" runs the real database in the browser (PGlite) with demo data – no backend needed.
#              "supabase" talks to a Supabase project.
VITE_DATA_SOURCE=local
VITE_DEMO_MODE=true
# MaskinID Supabase project "maskinid" (organisation maskinidab, region eu-north-1).
# The publishable key is meant for the frontend – all access is controlled by RLS and function grants.
# NEVER put the service role / secret key in a VITE_ variable.
VITE_SUPABASE_URL=https://ogpqatvgamzgwwhgtlcr.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_-QCInqZeE343lw9Kagjd5A_MGpoz8-5
VITE_SENTRY_DSN=
VITE_TURNSTILE_SITE_KEY=

# --- Local database for tests -----------------------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# --- Edge Function secrets (set with `supabase secrets set`, never in VITE_) ----
# Payments (step 23, ADR 0020). DEMO_MODE=true or no key ⇒ mock provider. Only sk_test_ keys are accepted unless
# STRIPE_ALLOW_LIVE=true. One Stripe price per paid plan; a 25 % exclusive tax rate so VAT is shown separately.
PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_RATE_ID=
STRIPE_PRICE_DEALER=
STRIPE_PRICE_FINANCIER=
STRIPE_PRICE_INSURER=
STRIPE_PRICE_MARKETPLACE=
STRIPE_ALLOW_LIVE=false
# Web push (step 24, ADR 0021). Generate a P-256 VAPID key pair (e.g. `npx web-push generate-vapid-keys`); the public key
# is also given to the client as VITE_VAPID_PUBLIC_KEY. Without keys (or in DEMO_MODE) push uses the mock sender.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:drift@maskinid.se
VITE_VAPID_PUBLIC_KEY=
